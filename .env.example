# Model provider (the user chooses the model)
# LLM_PROVIDER: "openai" (any OpenAI-compatible endpoint) or "anthropic"
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Prices in USD per million tokens, from the provider's price page.
# A paid run refuses to start without the input and output prices.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_PRICE_CACHED_INPUT_PER_MTOK=
LLM_PRICE_CACHE_WRITE_PER_MTOK=

# Optional. Output-token limit per call (default 4096) and reasoning effort
# (default "low"; "none" sends no setting). A model that rejects the effort setting
# is called without it automatically.
LLM_MAX_OUTPUT_TOKENS=
LLM_REASONING_EFFORT=
# Optional. 1 starts in plain mode for an OpenAI-compatible endpoint that rejects
# strict tools, parallel_tool_calls, prompt_cache_key or max_completion_tokens.
# Normally not needed: the client switches to it by itself after a rejection.
LLM_OPENAI_MINIMAL=

# Spending cap in USD for everything logged in results/spend.jsonl, across runs
BUDGET_USD=

# browser-harness telemetry must stay off
BH_TELEMETRY=0

# Browser binary (Chrome or Edge). Empty: auto-detect.
BROWSER_PATH=
# Browser profile and harness runtime files; keep them off C:
BROWSER_AGENT_DATA_DIR=D:\browser-agent-data

# WebArena Verified shopping-admin site
WEBARENA_SHOPPING_ADMIN_URL=http://localhost:7780
WEBARENA_SHOPPING_ADMIN_ENV_CTRL_URL=http://localhost:7781
